<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ModAssembly</AssemblyName>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\game-sandbox</GameDirectory>
    <GameData>$(GameDirectory)\data_PlantsVsZombies_windows_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PlantsVsZombies"><HintPath>$(GameData)\PlantsVsZombies.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
